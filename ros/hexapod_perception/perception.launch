<launch>
  <arg name="config" default="$(find hexapod_perception)/config/perception.yaml" />
  <arg name="model_path" default="$(find hexapod_perception)/models/landing_seg.pt" />
  <arg name="front_feature_model_path" default="$(find hexapod_perception)/models/xiaolan_front_feature_seg.pt" />
  <arg name="green_feature_model_path" default="$(find hexapod_perception)/models/xiaolan_top_green_seg.pt" />
  <arg name="output_frame" default="base_link" />
  <arg name="device" default="cpu" />

  <node pkg="hexapod_perception" type="perception_node"
        name="hexapod_perception" output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="model_path" value="$(arg model_path)" />
    <param name="front_feature_model_path" value="$(arg front_feature_model_path)" />
    <param name="green_feature_model_path" value="$(arg green_feature_model_path)" />
    <param name="output_frame" value="$(arg output_frame)" />
    <param name="device" value="$(arg device)" />
  </node>
</launch>
